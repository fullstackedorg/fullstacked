{
    "compilerOptions": {
        "esModuleInterop": true,
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "jsx": "react",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "strictNullChecks": false,
        "paths": {
            "@fullstacked/sass": ["./plugins/sass/index.ts"],
            "@fullstacked/tailwindcss": ["./plugins/tailwindcss/index.ts"]
        }
    },
    "exclude": [
        "out",
        "core/typescript-go",
        "platform/android",
        "platform/apple",
        "platform/docker",
        "platform/linux",
        "platform/node/fullstacked_modules",
        "platform/windows"
    ]
}
