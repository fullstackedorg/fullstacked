{
    "compilerOptions": {
        "esModuleInterop": true,
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "jsx": "react",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "strictNullChecks": false,
        "paths": {
            "fullstacked": ["./core/internal/bundle/lib/fullstacked/index.ts"],
            "fullstacked/*": ["./core/internal/bundle/lib/*/index.ts"]
        }
    },
    "exclude": [
        "out",
        "core/typescript-go",
        "platform/android",
        "platform/apple",
        "platform/docker",
        "platform/linux",
        "platform/windows"
    ]
}
