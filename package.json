{
    "version": "1.0.0-alpha",
    "scripts": {
        "generate-types": "node generate-types.ts",
        "build": "node build.ts",
        "start": "node index.ts",
        "fmt": "sh ./fmt.sh",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run build && npm run build -w platform/node",
        "test": "node --test-timeout=180000 --experimental-test-coverage --test-coverage-exclude='**/*.js' --test-coverage-exclude='**/*.cjs' --test-coverage-exclude='test/**/*' test/index.ts"
    },
    "workspaces": [
        "shell",
        "platform/node",
        "plugins/*"
    ],
    "author": "FullStacked",
    "license": "MIT",
    "type": "module",
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1155.0",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "dompurify": "^3.4.17",
        "dotenv": "^18.0.8",
        "esbuild": "^0.28.2",
        "node-gyp": "^13.1.0",
        "node-ssh": "^13.2.1",
        "pg": "^8.23.1",
        "prettier": "^3.9.10",
        "puppeteer": "^25.16.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild": true,
        "puppeteer": true
    }
}
