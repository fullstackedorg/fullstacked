{
    "version": "1.0.0-alpha",
    "scripts": {
        "generate-types": "node -r @nitrogql/esbuild-register generate-types",
        "build": "node -r @nitrogql/esbuild-register build",
        "start": "node -r @nitrogql/esbuild-register index",
        "fmt": "sh ./fmt.sh",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run build && npm run build -w platform/node",
        "test": "node --experimental-test-coverage --test-coverage-exclude='**/*.js' --test-coverage-exclude='test/**/*' -r @nitrogql/esbuild-register test"
    },
    "workspaces": [
        "platform/electron",
        "platform/node",
        "platform/wasm"
    ],
    "author": "FullStacked",
    "license": "MIT",
    "type": "module",
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1068.0",
        "@fullstacked/builder-tailwindcss": "github:fullstackedorg/builder-tailwindcss",
        "@nitrogql/esbuild-register": "^1.7.2",
        "@tailwindcss/cli": "^4.3.1",
        "@types/pg": "^8.20.0",
        "assert": "^2.1.0",
        "audit": "^0.0.6",
        "browserify-zlib": "^0.2.0",
        "buffer": "^6.0.3",
        "constants-browserify": "^1.0.0",
        "crypto-browserify": "^3.12.1",
        "csstype": "^3.2.3",
        "dc-polyfill": "^0.1.11",
        "dotenv": "^17.4.2",
        "elliptic": "^6.6.1",
        "esbuild": "^0.28.1",
        "events": "^3.3.0",
        "fast-querystring": "^1.1.2",
        "node-gyp": "^13.0.0",
        "node-ssh": "^13.2.1",
        "npm": "^11.17.0",
        "pg": "^8.21.0",
        "prettier": "^3.8.4",
        "process": "^0.11.10",
        "puppeteer": "^25.1.0",
        "readable-stream": "^4.7.0",
        "string_decoder": "^1.3.0",
        "typescript": "^6.0.3",
        "util": "^0.12.5"
    },
    "overrides": {
        "tar": "^7.5.16"
    },
    "devDependencies": {
        "@types/node": "^25.9.3"
    }
}
