{
    "version": "1.0.0-alpha",
    "scripts": {
        "generate-types": "node generate-types.ts",
        "build": "node build.ts",
        "start": "node index.ts",
        "fmt": "sh ./fmt.sh",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run build && npm run build -w platform/node",
        "test": "node --experimental-test-coverage --test-coverage-exclude='**/*.js' --test-coverage-exclude='**/*.cjs' --test-coverage-exclude='test/**/*' test/index.ts"
    },
    "workspaces": [
        "app/*",
        "platform/electron",
        "platform/node",
        "platform/wasm",
        "plugins/*"
    ],
    "author": "FullStacked",
    "license": "MIT",
    "type": "module",
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1091.0",
        "@tailwindcss/cli": "^4.3.3",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "@xmldom/xmldom": "^0.9.10",
        "assert": "^2.1.0",
        "audit": "^0.0.6",
        "browserify-zlib": "^0.2.0",
        "buffer": "^6.0.3",
        "constants-browserify": "^1.0.0",
        "crypto-browserify": "^3.12.1",
        "csstype": "^3.2.3",
        "dc-polyfill": "^0.1.11",
        "dotenv": "^17.4.2",
        "elliptic": "^6.6.1",
        "esbuild": "^0.28.1",
        "events": "^3.3.0",
        "fast-querystring": "^1.1.2",
        "node-gyp": "^13.0.1",
        "node-ssh": "^13.2.1",
        "pg": "^8.22.0",
        "prettier": "^3.9.6",
        "puppeteer": "^25.3.0",
        "readable-stream": "^4.7.0",
        "string_decoder": "^1.3.0",
        "typescript": "^7.0.2",
        "util": "^0.12.5"
    },
    "overrides": {
        "tar": "^7.5.21"
    },
    "allowScripts": {
        "esbuild": true,
        "puppeteer": true
    }
}
