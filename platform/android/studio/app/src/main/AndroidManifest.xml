<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Each permission and why: docs/contributing/store-review.md#android -->
    <!-- The core's sockets, DNS, fetch and WebSocket, and the webview -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- navigator.onLine and the online/offline events of the webview -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ActivityManager.moveTaskToFront, back to the window after a sign-in or a deeplink -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Asked at runtime only when a project's page asks (WebPermissions.kt):
         getUserMedia video, getUserMedia audio, navigator.geolocation -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The webview's WebRTC audio sets the audio mode while it captures (normal permission) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The permissions above imply these features: not required, so the app still
         installs on devices without them (Chromebooks, tablets without a camera) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- usesCleartextTraffic: the page is served on http://localhost, and projects
         load http:// resources (devices and servers on the local network) -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FullStackedEditor"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            android:resizeableActivity="true"
            android:theme="@style/Theme.FullStackedEditor"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|uiMode|keyboard|keyboardHidden|navigation"
        >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fullstacked-ctx" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AuthCallbackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fullstacked-auth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
        >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fullstacked" />
            </intent-filter>
        </activity>

        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true"/>
    </application>

</manifest>